# Nix build results
result
result-*

# direnv
.direnv/

# editor cruft
*.swp
*~
.DS_Store

# never version raw key material or env files
# (sops-encrypted files under secrets/ are intentionally NOT excluded here -
# they're ciphertext and are meant to be committed; verify with `git show`
# before committing that any *.yaml under secrets/ starts with ENC[ / sops:
# metadata, never plaintext)
*.pem
*.key
id_rsa*
id_ed25519*
*.pfx
.env
.env.*
